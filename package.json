{
  "name": "contextcheck",
  "version": "0.1.0",
  "description": "AI coding configuration intelligence layer — local-first lint, analysis and versioning for AI coding instructions",
  "type": "module",
  "license": "MIT",
  "bin": {
    "contextcheck": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "llm",
    "context",
    "agent",
    "configuration",
    "lint",
    "claude",
    "cursor",
    "skills",
    "instructions",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/kogu1988/contextcheck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kogu1988/contextcheck.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  }
}
