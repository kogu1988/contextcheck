# context-check environment template
#
# ContextCheck is local-first: it currently needs NO environment variables and
# sends nothing anywhere. These variables are reserved for future, opt-in
# cloud/sync/deployment features — they are NOT required for analyze / snapshot /
# diff / projects to work.
#
# Never commit a real .env file. Copy this to .env.local and fill only what you
# need (if ever). Only values you set are read.

# --- Reserved for future cloud/sync (NOT required for local use) ---
# CONTEXTCHECK_API_URL=
# CONTEXTCHECK_API_KEY=

# --- Deferred: CI / registration ---
# NPM_TOKEN=            # only for publishing, normally set in CI, never here
